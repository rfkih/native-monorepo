.gradle/
build/
**/build/
# Kotlin build-tools daemon working dir (e.g. build-logic/.kotlin) — transient, never source
**/.kotlin/
# Eclipse/JDT + VS Code Java compiled-output dirs (one per module) — never source
bin/
.idea/
*.iml
node_modules/
.DS_Store
__pycache__/
*.pyc
!gradle-wrapper.jar

# Claude Code — personal/local overrides (bypass mode, machine-specific allows). Shared rules live in .claude/settings.json (committed).
.claude/settings.local.json

# Local dev screenshot helpers — machine-specific paths + a local seed login, never source
frontend/console/*shot.mjs

# Gradle build-logic CLI worktree workaround output
build-logic/tmp/

# UAT stack runtime env — the current tunnel URL + GENERATED SECRETS (KC admin password,
# PII/gift-card keys). Never commit; losing it strands the UAT data (see docker/uat/README.md).
docker/uat.env

# PROD stack runtime env — the public URL(s) + GENERATED SECRETS, distinct from UAT's
# (ADR 0057; secrets NEVER reused across environments). Never commit; root-only on the VPS
# + an encrypted offsite copy. Losing it strands the prod data. See docker/prod/README.md.
docker/prod.env
# Named-tunnel credentials (cloudflared tunnel <UUID>.json) — a secret, like a client cert.
docker/prod/cloudflared/*.json
# Digest-pinned image override — GENERATED per release by scripts/release-manifest.ps1
# (ADR 0057). The immutable record is the git tag + the VPS deploy log, not this file.
docker/compose.prod.images.yml

# AI-gate working files — produced in CI by ai-gates.yml (and by local dry-runs of its prompts).
ai-gate.diff
ai-verdict.json

# Playwright e2e artifacts (e2e/ suite — ADR 0053 gate 2)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Signed Android installers served by the UAT edge (/*.apk -> docker/uat/downloads mount).
# Binaries stay out of git; source of truth is C:\Users\rifki\native-till-signing\builds\.
docker/uat/downloads/*.apk
