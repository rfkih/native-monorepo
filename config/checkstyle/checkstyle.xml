<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Native Checkstyle config: SEMANTIC-ONLY. Spotless + google-java-format owns ALL
  formatting (indentation, line length, import order, brace wrapping), so this
  carries no formatting rules and the two tools never fight. It catches only
  correctness issues google-java-format cannot.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>
  <!-- google-java-format uses spaces; forbid hard tabs. -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>
  <module name="TreeWalker">
    <!-- Imports: dead / duplicate / wildcard. -->
    <module name="UnusedImports">
      <property name="processJavadoc" value="true"/>
    </module>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport"/>
    <!-- Ban traps. java.util.logging: use SLF4J. sun.*: internal/unstable. -->
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, java.util.logging"/>
    </module>
    <!-- Correctness checks google-java-format cannot make. -->
    <module name="NeedBraces"/>
    <module name="MissingOverride"/>
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="EmptyStatement"/>
  </module>
  <!-- Optional file-based suppressions (Checker-level filter). The comment/warnings
       filters are TreeWalker-scoped and omitted until a suppression need arises. -->
  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
    <property name="optional" value="true"/>
  </module>
</module>
