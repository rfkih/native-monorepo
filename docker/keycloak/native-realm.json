{
  "realm": "native",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 15,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(10) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "displayName": "Native",
  "displayNameHtml": "<span class='native-wordmark'><span class='mark'><svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M4 18 L10 10 L14 14 L20 5'/></svg></span>Native</span>",
  "loginTheme": "native",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "owner", "description": "Company owner — full console access" },
      { "name": "manager", "description": "Scope-limited manager" },
      { "name": "cashier", "description": "Operational POS user" },
      { "name": "employee", "description": "Self-service employee — /me surface only" },
      { "name": "hr", "description": "HR — employee records, leave, expense claims, payroll" },
      { "name": "accountant", "description": "Detailed finance back-office — AP/AR/bank/tax/books" },
      { "name": "chef", "description": "Kitchen floor — POS till access like a cashier" },
      { "name": "waitress", "description": "Front-of-house floor — POS till access like a cashier" }
    ]
  },
  "clients": [
    {
      "clientId": "native-gateway",
      "name": "Native gateway client",
      "description": "Confidential client the apps/BFF use to obtain RS256 access tokens carrying company_id + roles. Direct Access Grants are enabled so automated tests can fetch a real token via the password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "actor_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "actor_type",
            "claim.name": "actor_type",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "native-admin",
      "name": "Native admin service-account client",
      "description": "Confidential client for the org-service to manage Keycloak users via the Admin REST API (client-credentials only; no user-facing flows).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "native-console",
      "name": "Native console SPA",
      "description": "Public SPA client: authorization-code + PKCE (no secret); token carries company_id + roles for the gateway. Set the real console origin per env (no wildcard). https://localhost = Capacitor origin of the bundled Android shell (ADR 0051).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:4173/*", "https://localhost/*"],
      "webOrigins": ["+"],
      "attributes": {
        "access.token.signed.response.alg": "RS256",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:4173/*##https://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "actor_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "actor_type",
            "claim.name": "actor_type",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner-acme",
      "enabled": true,
      "email": "owner@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Owner",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "owner-password", "temporary": false }
      ],
      "realmRoles": ["owner", "manager"]
    },
    {
      "username": "service-account-native-admin",
      "enabled": true,
      "email": "service-account-native-admin@placeholder.nativeapp.id",
      "emailVerified": true,
      "serviceAccountClientId": "native-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    },
    {
      "username": "cashier-acme",
      "enabled": true,
      "email": "cashier@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Cashier",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "cashier-password", "temporary": false }
      ],
      "realmRoles": ["cashier"]
    }
  ]
}
