# Native PROD runtime env — TEMPLATE. Copy to docker/prod.env (gitignored) and fill in.
# ADR 0053 + ADR 0057.
#
#   ⚠  NEVER commit docker/prod.env. Secrets are NEVER reused from UAT — generate FRESH.
#   ⚠  On the VPS: root-only (chmod 600, owned by the deploy user) + an ENCRYPTED offsite
#      copy. Losing this file strands the prod data (the PII/operator keys are unrecoverable
#      and every encrypted column becomes unreadable). This is the interim before Vault
#      (ADR 0053 "deferred"). scripts/prod-up.ps1 (Phase 5) generates any missing secret.
#
# Generate a value:
#   32-byte base64 key (all NATIVE_*/ORG_/MEDIA_ keys):  openssl rand -base64 32
#   password / client secret:                            openssl rand -base64 24
# NOTE: scripts/prod-bootstrap.sh generates this whole file (fresh secrets) on first run —
# this example documents the keys; you normally never write prod.env by hand.

# --- Tunnel profile (deploy/rollback/bootstrap export this so `up --remove-orphans` never
# deletes the running tunnel containers). quicktunnel now; namedtunnel once a domain exists.
COMPOSE_PROFILES=quicktunnel

# --- Image source (ADR 0053 §1: prod PULLS, never builds) ------------------------------
# Phase 2 pins NATIVE_IMAGE_TAG to an immutable @sha256 digest from a release manifest;
# until then a git SHA (from images.yml) is the deployable ref. `latest` is NOT for prod.
IMAGE_BASE=ghcr.io/rfkih/native-monorepo
NATIVE_IMAGE_TAG=REPLACE_WITH_RELEASE_SHA_OR_DIGEST

# --- Public URLs (the Cloudflare tunnel origins) ---------------------------------------
# INTERIM quick tunnels: scripts/prod-up.ps1 discovers these from the cloudflared metrics
# ports and rewrites them here on every bring-up (they change each restart). NAMED tunnel:
# set these to the stable domain URLs once (e.g. https://app.example.com / https://me.example.com).
# PUBLIC_URL is the BUSINESS origin AND the shared token issuer (both apps auth here).
PUBLIC_URL=https://REPLACE.trycloudflare.com
EMPLOYEE_PUBLIC_URL=https://REPLACE-employee.trycloudflare.com

# --- Keycloak ---
KC_ADMIN_PASSWORD=REPLACE_ME            # bootstrap admin (first empty-DB boot only)
KEYCLOAK_ADMIN_SECRET=REPLACE_ME        # org-service's KC admin-REST client secret

# --- PII / crypto keys (rule 6). prod profile REFUSES the dev placeholders at startup. ---
ORG_PII_KEY=REPLACE_ME                  # org-service device-credential cipher (ADR 0049 P3a)
NATIVE_PII_KEY=REPLACE_ME               # loyalty/employee/payment PII cipher
NATIVE_PII_HMAC_KEY=REPLACE_ME          # loyalty PII blind-index HMAC
NATIVE_GIFTCARD_CODE_KEY=REPLACE_ME     # gift-card code cipher (restaurant/carwash/barbershop/loyalty)
NATIVE_OPERATOR_TOKEN_KEY=REPLACE_ME    # operator-PIN token sign/verify (ADR 0049)

# --- MinIO (object store, ADR 0048) ---
MINIO_ROOT_PASSWORD=REPLACE_ME
MEDIA_RESTAURANT_SECRET_KEY=REPLACE_ME  # restaurant/ prefix-scoped user
MEDIA_EMPLOYEE_SECRET_KEY=REPLACE_ME    # employee/ prefix-scoped user
MEDIA_PAYMENT_SECRET_KEY=REPLACE_ME     # payment/ prefix-scoped user

# --- Named-tunnel profile only (leave blank while on quick tunnels) ---
# The tunnel UUID from `cloudflared tunnel create native-prod`; its credentials JSON goes to
# docker/prod/cloudflared/<UUID>.json (gitignored). See config.yml.example.
TUNNEL_UUID=
