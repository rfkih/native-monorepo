{
  "TCP": {
    "443": { "HTTPS": true },
    "10000": { "HTTPS": true }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": { "/": { "Proxy": "http://edge:8080" } }
    },
    "${TS_CERT_DOMAIN}:10000": {
      "Handlers": { "/": { "Proxy": "http://edge:8081" } }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true,
    "${TS_CERT_DOMAIN}:10000": true
  }
}
