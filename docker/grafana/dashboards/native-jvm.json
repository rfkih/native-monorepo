{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "JVM and process health per service — heap, GC, threads, CPU. Standard Micrometer JVM metrics (fleet-wide via libs/observability). Scorecard #13.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 30,
      "title": "Heap memory",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"}",
          "legendFormat": "{{service}} {{id}} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_memory_committed_bytes{service=~\"$service\", area=\"heap\"}",
          "legendFormat": "{{service}} {{id}} committed",
          "refId": "B"
        }
      ],
      "title": "Heap Used / Committed",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_memory_used_bytes{service=~\"$service\", area=\"nonheap\"}",
          "legendFormat": "{{service}} {{id}} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_memory_committed_bytes{service=~\"$service\", area=\"nonheap\"}",
          "legendFormat": "{{service}} {{id}} committed",
          "refId": "B"
        }
      ],
      "title": "Non-Heap (Metaspace / Code Cache) Used / Committed",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 31,
      "title": "Garbage Collection",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[$__rate_interval]) / rate(jvm_gc_pause_seconds_count{service=~\"$service\"}[$__rate_interval])",
          "legendFormat": "{{service}} {{action}} {{cause}} avg pause",
          "refId": "A"
        }
      ],
      "title": "GC Average Pause Duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "rate(jvm_gc_pause_seconds_count{service=~\"$service\"}[$__rate_interval])",
          "legendFormat": "{{service}} {{action}} {{cause}} rate",
          "refId": "A"
        }
      ],
      "title": "GC Pause Frequency (pauses/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 32,
      "title": "CPU and process",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "process_cpu_usage{service=~\"$service\"}",
          "legendFormat": "{{service}} process CPU",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "system_cpu_usage{service=~\"$service\"}",
          "legendFormat": "{{service}} system CPU",
          "refId": "B"
        }
      ],
      "title": "Process / System CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_threads_live_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} live",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_threads_daemon_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} daemon",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_threads_peak_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} peak",
          "refId": "C"
        }
      ],
      "title": "JVM Thread Count",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 33,
      "title": "Class loading and buffer pools",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_classes_loaded_classes{service=~\"$service\"}",
          "legendFormat": "{{service}} loaded",
          "refId": "A"
        }
      ],
      "title": "JVM Classes Loaded",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_buffer_memory_used_bytes{service=~\"$service\"}",
          "legendFormat": "{{service}} {{id}} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "jvm_buffer_total_capacity_bytes{service=~\"$service\"}",
          "legendFormat": "{{service}} {{id}} capacity",
          "refId": "B"
        }
      ],
      "title": "JVM Buffer Pool (direct / mapped)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 34,
      "title": "Process uptime and start time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "native-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 37 },
      "id": 9,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "native-prometheus" },
          "expr": "process_uptime_seconds{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Process Uptime",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["native", "jvm", "process"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "native-prometheus" },
        "definition": "label_values(jvm_memory_used_bytes, service)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(jvm_memory_used_bytes, service)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Service"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Native — JVM / Process",
  "uid": "native-jvm",
  "version": 1
}
