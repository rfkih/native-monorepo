# Production build defaults (mode=production). Real Keycloak OIDC login + bearer to the gateway.
#
# API base + Keycloak URL are normally injected at CONTAINER START via /env.js
# (window.__NATIVE_CONFIG__, see Dockerfile + docker-entrypoint), so ONE image works across
# environments. The values below are only the build-time fallback.
VITE_AUTH_MODE=oidc
# Same-origin by default: the console is served behind the gateway/ingress, so /api/** is relative.
VITE_API_BASE_URL=
# VITE_KEYCLOAK_URL / VITE_KEYCLOAK_REALM are injected at runtime (env.js) in real deployments.
