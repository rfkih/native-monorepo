{
  "name": "native-employee",
  "version": "0.1.0",
  "description": "Native Karyawan — Android thin-client shell over the live console's employee self-service surface (ADR 0049 P5)",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "apk": "cap sync android && cd android && gradlew assembleUatDebug",
    "build:uat": "node scripts/build-app.mjs --env uat",
    "build:prod": "node scripts/build-app.mjs --env prod",
    "aab:prod": "node scripts/build-app.mjs --env prod --format aab",
    "aab:uat": "node scripts/build-app.mjs --env uat --format aab",
    "store:assets": "node scripts/render-store-assets.mjs",
    "store:shots": "node scripts/frame-store-shots.mjs",
    "icons": "node scripts/render-launcher-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "typescript": "^7.0.2"
  }
}
