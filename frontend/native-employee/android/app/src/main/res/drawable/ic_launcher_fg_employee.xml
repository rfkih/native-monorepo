<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground for the EMPLOYEE app — a person glyph, not the shared trend mark.

     Why it differs from the Business app: both apps are installed side by side on the same phone
     (a manager runs Native, their staff run Native Karyawan) and both list on Google Play under one
     developer. An identical icon makes them indistinguishable in the launcher and in the store.
     Family resemblance is carried entirely by the SHARED background (ic_launcher_bg_brand: the
     brand-500 → brand-800 cyan tile) and the same white rounded-stroke language; only the glyph
     changes, which is what stays legible at 48dp.

     The glyph is lucide `user` (head circle + shoulders arc) — the same mark the /me surface already
     uses in its profile header — in the same 24-unit viewport as the brand mark, scaled into the
     66/108 safe zone with the identical group transform as ic_launcher_fg_brand so the two icons sit
     at matching optical weight. The circle is written as two arcs because VectorDrawable has no
     <circle>. Revise here if lucide's `user` path ever changes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.3"
        android:scaleY="2.3"
        android:translateX="26.4"
        android:translateY="26.4">
        <!-- shoulders -->
        <path
            android:pathData="M19,21 V19 A4,4 0 0,0 15,15 H9 A4,4 0 0,0 5,19 V21"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- head -->
        <path
            android:pathData="M16,7 A4,4 0 0,1 8,7 A4,4 0 0,1 16,7 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
