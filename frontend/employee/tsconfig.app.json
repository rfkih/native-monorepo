{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* "@/*" reuses the console's source (read-only — see vite.config.ts). The rest pin the
       SAME single-instance fix as vite.config.ts's `resolve.dedupe`, but for tsc: unlike a
       Vite alias, unmapped bare specifiers resolve per-importing-FILE location even within one
       tsc "program", so a file physically inside ../console/src (pulled in below) would
       otherwise type-check against the CONSOLE's own node_modules copy of these packages —
       a different (structurally incompatible, e.g. #private-field-branded) type than this
       package's own copy — for `@tanstack/react-query`'s `QueryClient` this is a hard TS error,
       not just a lint nit. `react`/`react-dom` are DELIBERATELY left unmapped: they're
       DefinitelyTyped-typed (no inline .d.ts), and redirecting the bare specifier straight at
       `./node_modules/react` skips TS's automatic `@types/react` fallback entirely (breaks with
       TS7016 "implicitly has an 'any' type"); their structural (interface, not class) types tolerate
       duplication for tsc's purposes regardless, so `resolve.dedupe` in vite.config.ts alone (the
       RUNTIME single-instance fix, for the "Invalid hook call" hazard) is enough on that side. */
    "paths": {
      "@/*": ["../console/src/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "react-i18next": ["./node_modules/react-i18next"],
      "i18next": ["./node_modules/i18next"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "oidc-client-ts": ["./node_modules/oidc-client-ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../console/src"],
  "exclude": ["../console/src/**/*.test.ts", "../console/src/**/*.test.tsx", "../console/src/**/__tests__/**"]
}
