{
  "realm": "native",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "owner", "description": "Company owner — full console access" },
      { "name": "manager", "description": "Scope-limited manager" },
      { "name": "cashier", "description": "Operational POS user" },
      { "name": "employee", "description": "Self-service employee — /me surface only" }
    ]
  },
  "clients": [
    {
      "clientId": "native-admin",
      "name": "Native admin service-account client",
      "description": "Confidential client for the org-service to manage Keycloak users via the Admin REST API (client-credentials only; no user-facing flows).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "native-gateway",
      "name": "Native gateway client",
      "description": "Confidential client the apps/BFF use to obtain RS256 access tokens carrying company_id + roles. Direct Access Grants are enabled so automated tests can fetch a real token via the password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "native-gateway-shortlived",
      "name": "Native gateway client (short-lived tokens)",
      "description": "Like native-gateway but with a 1s access-token lifespan, for the expired-token 401 proof.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-gateway-shortlived-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.signed.response.alg": "RS256",
        "access.token.lifespan": "1"
      },
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner-acme",
      "enabled": true,
      "email": "owner@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Owner",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "owner-password", "temporary": false }
      ],
      "realmRoles": ["owner", "manager"]
    },
    {
      "username": "service-account-native-admin",
      "enabled": true,
      "email": "service-account-native-admin@placeholder.nativeapp.id",
      "emailVerified": true,
      "serviceAccountClientId": "native-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    },
    {
      "username": "tenantless-user",
      "enabled": true,
      "email": "nobody@example.co.id",
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Less",
      "credentials": [
        { "type": "password", "value": "tenantless-password", "temporary": false }
      ],
      "realmRoles": ["owner"]
    },
    {
      "username": "cashier-acme",
      "enabled": true,
      "email": "cashier@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Cashier",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "cashier-password", "temporary": false }
      ],
      "realmRoles": ["cashier"]
    },
    {
      "username": "manager-acme",
      "enabled": true,
      "email": "manager@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Manager",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "manager-password", "temporary": false }
      ],
      "realmRoles": ["manager"]
    },
    {
      "username": "owner-multi",
      "enabled": true,
      "email": "owner@multi.example.co.id",
      "emailVerified": true,
      "firstName": "Multi",
      "lastName": "Owner",
      "attributes": {
        "company_id": [
          "22222222-2222-2222-2222-222222222222",
          "33333333-3333-3333-3333-333333333333"
        ]
      },
      "credentials": [
        { "type": "password", "value": "multi-password", "temporary": false }
      ],
      "realmRoles": ["owner", "manager"]
    }
  ]
}
