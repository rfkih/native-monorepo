{
  "realm": "native",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "owner", "description": "Company owner — full console access" },
      { "name": "manager", "description": "Scope-limited manager" },
      { "name": "cashier", "description": "Operational POS user" }
    ]
  },
  "clients": [
    {
      "clientId": "native-gateway",
      "name": "Native gateway client",
      "description": "Confidential client the apps/BFF use to obtain RS256 access tokens carrying company_id + roles. Direct Access Grants are enabled so automated tests can fetch a real token via the password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "native-gateway-shortlived",
      "name": "Native gateway client (short-lived tokens)",
      "description": "Like native-gateway but with a 1s access-token lifespan, for the expired-token 401 proof.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "native-gateway-shortlived-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.signed.response.alg": "RS256",
        "access.token.lifespan": "1"
      },
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner-acme",
      "enabled": true,
      "email": "owner@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Owner",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "owner-password", "temporary": false }
      ],
      "realmRoles": ["owner", "manager"]
    },
    {
      "username": "tenantless-user",
      "enabled": true,
      "email": "nobody@example.co.id",
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Less",
      "credentials": [
        { "type": "password", "value": "tenantless-password", "temporary": false }
      ],
      "realmRoles": ["owner"]
    },
    {
      "username": "cashier-acme",
      "enabled": true,
      "email": "cashier@acme.example.co.id",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Cashier",
      "attributes": {
        "company_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "cashier-password", "temporary": false }
      ],
      "realmRoles": ["cashier"]
    }
  ]
}
