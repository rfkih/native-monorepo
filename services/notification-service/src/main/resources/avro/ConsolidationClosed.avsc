{
  "type": "record",
  "name": "ConsolidationClosed",
  "namespace": "id.co.nativeapp.events.finance",
  "doc": "notification-service's CONSUMER copy of the ConsolidationClosed contract (producer: finance-service). Emitted by finance when a consolidation close completes for a company (or a group) and a period; consumed here as a notification TRIGGER — a 'consolidation closed for <period>' notice is created and delivered to the company recipient. notification owns its own consumer view of the schema so it can evolve its reader independently; a contract test asserts this copy stays backward-compatible with the producer schema (rule 7). Bytes are read as raw Avro via libs/events AvroSerde — NOT through a Schema Registry serde. Key fields per ARCHITECTURE.md §5: company_id (or group_id), period.",
  "fields": [
    {"name": "company_id", "type": "string", "doc": "The owning tenant / company id (UUID as string); the partition key and the tenant the notification is created under. For a group-level close this is the group's lead/owner company id (the tenant the notification belongs to)."},
    {"name": "group_id", "type": ["null", "string"], "default": null, "doc": "The consolidation GROUP id (UUID as string) when this was a group consolidation; null for a within-company close. Carried so the notification can name the scope; the notification is always tenant-scoped by company_id."},
    {"name": "period", "type": "string", "doc": "The accounting period that was closed (e.g. YYYY-MM)."}
  ]
}
