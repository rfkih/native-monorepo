    {
      "rule_key": "PPH21_ARTICLE17",
      "rule_version": "ID-2026.1",
      "calc_type": "ANNUAL_PROGRESSIVE",
      "provenance": "OFFICIAL",
      "source_note": "UU HPP No. 7/2021 Pasal 17 ayat (1) huruf a (Art-17 annual progressive brackets: 5% s.d. Rp60.000.000, 15% s.d. Rp250.000.000, 25% s.d. Rp500.000.000, 30% s.d. Rp5.000.000.000, 35% di atasnya). Biaya jabatan (occupational cost) rate and annual cap per PMK 250/2008 Pasal 1 (5%, capped Rp500.000/bulan = Rp6.000.000/tahun). No-NPWP surcharge per UU PPh Pasal 21 ayat (5a).",
      "effective_from": "2026-01-01",
      "params": {
        "brackets": [
          { "floor_minor": 0, "cap_minor": 60000000, "rate_bp": 500 },
          { "floor_minor": 60000000, "cap_minor": 250000000, "rate_bp": 1500 },
          { "floor_minor": 250000000, "cap_minor": 500000000, "rate_bp": 2500 },
          { "floor_minor": 500000000, "cap_minor": 5000000000, "rate_bp": 3000 },
          { "floor_minor": 5000000000, "cap_minor": 999999999999, "rate_bp": 3500 }
        ],
        "occupational_cost_bp": 500,
        "occupational_cost_cap_annual_minor": 6000000,
        "no_npwp_surcharge_bp": 12000
      }
    },
