{
  "type": "record",
  "name": "SaleRecorded",
  "namespace": "id.co.nativeapp.events.restaurant",
  "doc": "carwash-service's PRODUCER copy of the SaleRecorded contract — byte-identical to the restaurant-service producer schema and the finance-service consumer copy (same full name id.co.nativeapp.events.restaurant.SaleRecorded), so finance consolidates carwash revenue with the SAME ledger path it already uses for restaurant. Emitted by carwash-service when a wash is recorded; business_id is the carwash OUTLET. Money is an integer minor-units amount plus an ISO-4217 currency code, never a float (CLAUDE.md rule 8). A contract test asserts this copy stays backward-compatible with the producer schema (rule 7).",
  "fields": [
    {"name": "sale_id", "type": "string", "doc": "The wash/sale aggregate id (UUID as string); also the Kafka partition key."},
    {"name": "company_id", "type": "string", "doc": "The owning tenant (UUID as string)."},
    {"name": "business_id", "type": "string", "doc": "The originating business unit — the carwash outlet (UUID as string)."},
    {"name": "amount_minor", "type": "long", "doc": "Amount in the currency's minor units (e.g. cents for USD, whole rupiah for IDR). Never a float."},
    {"name": "currency", "type": "string", "doc": "ISO-4217 currency code, e.g. IDR or USD."},
    {"name": "occurred_at", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the wash occurred, epoch millis (UTC)."}
  ]
}
