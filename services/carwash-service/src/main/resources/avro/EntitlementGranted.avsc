{
  "type": "record",
  "name": "EntitlementGranted",
  "namespace": "id.co.nativeapp.events.entitlement",
  "doc": "carwash-service's CONSUMER copy of the entitlement-service EntitlementGranted contract (same full name id.co.nativeapp.events.entitlement.EntitlementGranted). Consumed into the LOCAL entitlement projection (entitled=true) and used to INVALIDATE the entitlement-check Redis cache, so record-wash gating reflects a grant promptly. A contract test asserts this copy stays backward-compatible with the producer schema (rule 7).",
  "fields": [
    {"name": "company_id", "type": "string", "doc": "The owning tenant / company id (UUID as string); also the Kafka partition key."},
    {"name": "module_key", "type": "string", "doc": "The module the company was granted (e.g. restaurant, carwash, laundromat, hr, finance)."},
    {"name": "granted_at", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the grant took effect, epoch millis (UTC)."}
  ]
}
