{
  "type": "record",
  "name": "PayrollPosted",
  "namespace": "id.co.nativeapp.events.employee",
  "doc": "finance-service's CONSUMER copy of the PayrollPosted contract (producer: employee-service, #23). The run-level control/announcement emitted when a payroll_run transitions CALCULATED -> POSTED. Company-level TOTALS ONLY — no per-person amounts, no salary/NIK/bank (rule 6). Produces NO ledger posting; finance uses it for (a) reconciliation against the sum of the run's LaborCostAllocated buckets, (b) recording the run-level illustrative flag, and (c) the supersession trigger / run-state machine. finance owns its own consumer view; a contract test asserts this copy stays backward-compatible with the producer schema (rule 7). Bytes are read as raw Avro via libs/events AvroSerde — NOT through a Schema Registry serde. Money is integer minor units + ISO-4217 code, never a float (rule 8). run_seq is added backward-compatibly (default 1) — the supersession signal finance keys on.",
  "fields": [
    {"name": "payroll_run_id", "type": "string", "doc": "The payroll run aggregate id (UUID as string); also the Kafka partition key."},
    {"name": "company_id", "type": "string", "doc": "The owning tenant (UUID as string)."},
    {"name": "period", "type": "string", "doc": "The run's accounting period YYYY-MM."},
    {"name": "base_currency", "type": "string", "doc": "ISO-4217 base currency the run's totals are denominated in."},
    {"name": "gross_total_minor", "type": "long", "doc": "Company-level gross total in minor units. Never a float."},
    {"name": "employee_deduction_total_minor", "type": "long", "doc": "Company-level employee-deduction total in minor units."},
    {"name": "employer_contribution_total_minor", "type": "long", "doc": "Company-level employer-contribution total in minor units. Part of the labor control total finance reconciles against (employer_contribution + the gross labor base)."},
    {"name": "net_total_minor", "type": "long", "doc": "Company-level net total in minor units."},
    {"name": "rule_versions", "type": {"type": "array", "items": {"type": "record", "name": "RuleVersion", "fields": [
      {"name": "rule_key", "type": "string"},
      {"name": "rule_version", "type": "string"}
    ]}}, "doc": "The frozen statutory rule_versions set (HR-7 reproducibility). Decoded but not persisted in the ledger; optionally retained on the run_ledger row for audit."},
    {"name": "run_seq", "type": "int", "default": 1, "doc": "The run sequence for the (company_id, period). A higher run_seq supersedes lower ones. Added backward-compatibly (default 1)."},
    {"name": "uses_illustrative_rules", "type": "boolean", "doc": "Whether the run was computed against ILLUSTRATIVE_PLACEHOLDER statutory figures — loud on the wire so finance cannot mistake it for an official-figure run."},
    {"name": "posted_at", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the run posted, epoch millis (UTC). The fallback supersession ordering if run_seq is genuinely absent."}
  ]
}
