{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre-commit-quality.sh\"",
            "timeout": 300,
            "statusMessage": "Quality gate: spotless + eslint on staged files"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git restore*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(./gradlew.bat *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(nslookup *)"
    ]
  }
}
